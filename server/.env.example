# DevMemory Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=devmemory
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# Server API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:5173

# Performance Monitoring & Regression Analytics
PERFORMANCE_REGRESSION_PERCENT_THRESHOLD=30.0
PERFORMANCE_REGRESSION_ABS_MS_THRESHOLD=100.0
PERFORMANCE_BASELINE_MIN_SAMPLES=5
