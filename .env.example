# DevMemory Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit real API keys or credentials to Git.

# Groq API Configuration (for AI diagnostic engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0

# Privacy & Offline Mode (Optional: set to 1/true to disable all cloud APIs)
DEV_MEMORY_DISABLE_EXTERNAL_AI=0

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=devmemory
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# Server API Configuration
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Performance Monitoring & Regression Analytics
PERFORMANCE_REGRESSION_PERCENT_THRESHOLD=30.0
PERFORMANCE_REGRESSION_ABS_MS_THRESHOLD=100.0
PERFORMANCE_BASELINE_MIN_SAMPLES=5
